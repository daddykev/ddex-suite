{
  "name": "ddex-builder-wasm",
  "version": "0.5.1",
  "description": "WASM bindings for DDEX Builder (the core Rust builder compiled to WebAssembly)",
  "main": "pkg/ddex_builder_wasm.js",
  "types": "pkg/ddex_builder_wasm.d.ts",
  "files": [
    "pkg"
  ],
  "scripts": {
    "build": "wasm-pack build --target web --out-dir pkg --release",
    "build:node": "wasm-pack build --target nodejs --out-dir pkg-node --release",
    "test": "npm run build:node && node test-node.cjs"
  },
  "license": "MIT",
  "author": "Kevin Marques Moo"
}
