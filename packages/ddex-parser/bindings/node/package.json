{
  "name": "ddex-parser",
  "version": "0.5.0",
  "description": "DDEX ERN XML parser (ERN 3.8.x, 4.2, 4.3) for Node.js, native Rust addon",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "require": "./index.js",
      "import": "./index.js",
      "types": "./index.d.ts"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "napi": {
    "name": "ddex-parser-node",
    "triples": {
      "defaults": true,
      "additional": [
        "aarch64-apple-darwin"
      ]
    }
  },
  "scripts": {
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "build:ts": "tsc",
    "artifacts": "napi artifacts",
    "version": "napi version",
    "test": "node test-manual.js && node test-community-prs.js && node test-ern4-tracks.js && node test-parser-fields.js && node test-types.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "ddex",
    "ern",
    "xml",
    "parser",
    "music",
    "metadata",
    "native"
  ],
  "author": "Kevin Marques Moo",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daddykev/ddex-suite.git",
    "directory": "packages/ddex-parser/bindings/node"
  },
  "homepage": "https://ddex-suite.org",
  "bugs": {
    "url": "https://github.com/daddykev/ddex-suite/issues"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "@types/node": "^20.19.13",
    "typescript": "^5.9.2"
  },
  "optionalDependencies": {
    "ddex-parser-darwin-arm64": "0.5.0",
    "ddex-parser-darwin-x64": "0.5.0",
    "ddex-parser-linux-x64-gnu": "0.5.0",
    "ddex-parser-win32-x64-msvc": "0.5.0"
  }
}
